<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.onairsign.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/on-air-sign/host-mac/monitor</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/on-air-sign/host-mac</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME_SSID</key>
        <string>YourHomeNetworkName</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/path/to/on-air-sign/host-mac/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/on-air-sign/host-mac/launchd.stderr.log</string>
</dict>
</plist>
