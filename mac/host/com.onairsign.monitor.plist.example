<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.onairsign.monitor</string>

    <!-- Replace <PATH_TO_NODE> (output of `which node`) and <PATH_TO_REPO> -->
    <key>ProgramArguments</key>
    <array>
        <string><PATH_TO_NODE></string>
        <string><PATH_TO_REPO>/mac/host/monitor.mjs</string>
    </array>

    <!-- Start on login; relaunch only after a crash, so a graceful stop (which turns the sign off) stays stopped -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- monitor.mjs writes its own logs; this only catches crash stack traces -->
    <key>StandardErrorPath</key>
    <string><PATH_TO_REPO>/mac/host/launchd.err.log</string>
</dict>
</plist>
